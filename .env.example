# Environment configuration for NEXWIN Studio

# Secret key used to sign and deterministically generate tamper-evident certificate IDs.
# App will refuse to generate certificates / lookup if this is missing.
CERTIFICATE_SECRET=dev-nexwin-certificate-secret-key-change-in-prod-2026

# Controls whether the Certificates tab is visible.
# Defaults to true in development, false in production builds until Phase 10.
NEXT_PUBLIC_ENABLE_CERTIFICATES=true

# Optional second verification check: requires participant to enter their team ID in addition to email.
# Defaults to false (off). When true, a mismatch gives the exact same generic error message.
REQUIRE_TEAM_ID=false
